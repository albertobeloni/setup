[Desktop Entry]
Categories=GNOME;GTK;System;Development;Emulator;
Comment=Create, view and use virtual machines
Comment[pt_BR]=Crie, veja e use máquinas virtuais
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=gnome-boxes --file-forwarding org.gnome.Boxes @@u %U @@
Icon=computer
Keywords=Boxes;Virtual Machine;VM;Emulator;Virtualization;
Keywords[pt_BR]=Boxes;Máquina virtual;VM;Emulador;Virtualização;
MimeType=application/x-cd-image;
Name=Virtual Machines
Name[pt_BR]=Máquinas virtuais
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Boxes
Type=Application
Version=1.5
X-Flatpak=org.gnome.Boxes
