[Desktop Entry]
Categories=GNOME;GTK;Utility;
Comment=Find and insert special characters and emoji
Comment[pt_BR]=Encontre e insira caracteres especiais e emojis
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=/app/bin/gnome-characters org.gnome.Characters
Icon=accessories-character-map
Keywords=GNOME Characters;Character;Emoji;Symbol;Unicode;
Keywords[pt_BR]=Caracteres do GNOME;Caractere;Emoji;Símbolo;Unicode;
Name=Characters
Name[pt_BR]=Caracteres
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Characters
Type=Application
Version=1.5
X-Flatpak=org.gnome.Characters
