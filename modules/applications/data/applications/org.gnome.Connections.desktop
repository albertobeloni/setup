[Desktop Entry]
Categories=GNOME;GTK;Utility;RemoteAccess;Network;
Comment=Connect to the desktop of other computers over the network
Comment[pt_BR]=Conecte-se à área de trabalho de outros computadores pela rede
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=gnome-connections --file-forwarding org.gnome.Connections @@u %U @@
Icon=preferences-desktop-remote-desktop
Keywords=Connections;VNC;RDP;Remote;Desktop;
Keywords[pt_BR]=Connections;VNC;RDP;Remoto;Área de trabalho;
MimeType=application/x-vnc
Name=Remote Desktop
Name[pt_BR]=Área de trabalho remota
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Connections
Type=Application
Version=1.5
X-Flatpak=org.gnome.Connections
