[Desktop Entry]
Categories=GTK;GNOME;System;Monitor;Utility;
Comment=View detailed event logs for the system
Comment[pt_BR]=Veja registros detalhados de eventos do sistema
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=gnome-logs org.gnome.Logs
Icon=utilities-log-viewer
Keywords=GNOME Logs;Log;Journal;Debug;Error;
Keywords[pt_BR]=Logs do GNOME;Log;Registro;Journal;Depuração;Erro;
Name=Logs
Name[pt_BR]=Logs
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Logs
Type=Application
Version=1.5
X-Flatpak=org.gnome.Logs
