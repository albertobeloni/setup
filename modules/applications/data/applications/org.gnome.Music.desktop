[Desktop Entry]
Categories=GNOME;GTK;AudioVideo;Player;Audio;
Comment=Play and organize your music collection
Comment[pt_BR]=Reproduza e organize sua coleção de músicas
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=gnome-music org.gnome.Music
Icon=audio-x-generic
Keywords=GNOME Music;Song;Album;Artist;Playlist;
Keywords[pt_BR]=Música do GNOME;Canção;Álbum;Artista;Lista de reprodução;
Name=Music
Name[pt_BR]=Música
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Music
Type=Application
Version=1.5
X-Flatpak=org.gnome.Music
