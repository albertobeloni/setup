[Desktop Entry]
Categories=AudioVideo;Video;Recorder;GNOME;GTK;
Comment=Take pictures and videos
Comment[pt_BR]=Tire fotos e grave vídeos
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=snapshot org.gnome.Snapshot
Icon=camera-photo
Keywords=Snapshot;Photo;Picture;Video;Webcam;
Keywords[pt_BR]=Snapshot;Foto;Imagem;Vídeo;Webcam;
Name=Camera
Name[pt_BR]=Câmera
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Snapshot
Type=Application
Version=1.5
X-Flatpak=org.gnome.Snapshot
