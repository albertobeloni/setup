[Desktop Entry]
Categories=GNOME;GTK;Utility;Clock;
Comment=Clocks for world times, plus alarms, stopwatch and a timer
Comment[pt_BR]=Relógios com horários mundiais, alarmes, cronômetro e temporizador
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=gnome-clocks org.gnome.clocks
Icon=preferences-system-time
Keywords=GNOME Clocks;Time;Timer;Alarm;World Clock;Stopwatch;Timezone;
Keywords[pt_BR]=Relógios do GNOME;Hora;Temporizador;Alarme;Relógio mundial;Cronômetro;Fuso horário;
Name=Clocks
Name[pt_BR]=Relógios
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.clocks
Type=Application
Version=1.5
X-Flatpak=org.gnome.clocks
X-Geoclue-Reason=Allows world clocks to be displayed for your time zone.
