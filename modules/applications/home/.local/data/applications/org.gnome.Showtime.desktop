[Desktop Entry]
Actions=new-window;
Categories=AudioVideo;Video;Player;GNOME;GTK;
Comment=Watch movies and other video files
Comment[pt_BR]=Assista a filmes e outros arquivos de vídeo
DBusActivatable=true
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=showtime --file-forwarding org.gnome.Showtime --new-window @@u %U @@
Icon=multimedia-video-player
Keywords=Showtime;Video;Movie;Film;Clip;Player;
Keywords[pt_BR]=Showtime;Vídeo;Filme;Clipe;Reprodutor;
MimeType=video/3gp;video/3gpp;video/3gpp2;video/dv;video/divx;video/fli;video/flv;video/mp2t;video/mp4;video/mp4v-es;video/mpeg;video/mpeg-system;video/msvideo;video/ogg;video/quicktime;video/vivo;video/vnd.divx;video/vnd.mpegurl;video/vnd.rn-realvideo;video/vnd.vivo;video/webm;video/x-anim;video/x-avi;video/x-flc;video/x-fli;video/x-flic;video/x-flv;video/x-m4v;video/x-matroska;video/x-mjpeg;video/x-mpeg;video/x-mpeg2;video/x-ms-asf;video/x-ms-asf-plugin;video/x-ms-asx;video/x-msvideo;video/x-ms-wm;video/x-ms-wmv;video/x-ms-wvx;video/x-nsv;video/x-ogm+ogg;video/x-theora;video/x-theora+ogg;
Name=Video Player
Name[pt_BR]=Reprodutor de vídeos
StartupNotify=true
Terminal=false
TryExec=/var/lib/flatpak/exports/bin/org.gnome.Showtime
Type=Application
Version=1.5
X-Flatpak=org.gnome.Showtime

[Desktop Action new-window]
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=showtime org.gnome.Showtime --new-window
Name=New Window
Name[pt_BR]=Nova janela
