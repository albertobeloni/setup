[Unit]
Description=Hide the Noctalia bar while the Umbriel overview is open
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/umbriel-events.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=umbriel-session.target
