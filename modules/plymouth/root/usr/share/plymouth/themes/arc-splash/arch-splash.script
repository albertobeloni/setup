Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("arch-splash.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2, 0);

prompt.sprite = Sprite();
bullets.sprite = Sprite();
text_y = cy + logo.image.GetHeight() / 2 + 40;

fun display_password_callback(prompt_text, count) {
    p = Image.Text(prompt_text, 0.8, 0.8, 0.8);
    prompt.sprite.SetImage(p);
    prompt.sprite.SetPosition(cx - p.GetWidth() / 2, text_y, 1);
    prompt.sprite.SetOpacity(1);

    s = "";
    for (i = 0; i < count; i++) s = s + "•";
    if (count > 0) {
        b = Image.Text(s, 1, 1, 1);
        bullets.sprite.SetImage(b);
        bullets.sprite.SetPosition(cx - b.GetWidth() / 2, text_y + 30, 1);
        bullets.sprite.SetOpacity(1);
    } else {
        bullets.sprite.SetOpacity(0);
    }
}

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
