#!/bin/bash

function include() {
	command local directory

	directory="${1}"

	if command test -d "${directory}"
	then
		command local file

		for file in "${directory}"/*.sh
		do
			if command test -r "${file}"
			then
				command source "${file}"
			fi
		done
	fi
}

include "${XDG_CONFIG_HOME:-${HOME}/.local/config}/bash/bash.d"

command unset -f include
