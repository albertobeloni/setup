#!/bin/sh

shell_include()
{
	directory="${1}"

	if command test -d "${directory}"
	then
		for file in "${directory}"/*.sh
		do
			if command test -r "${file}"
			then
				command . "${file}"
			fi
		done

		command unset -v file
	fi

	command unset -v directory
}

shell_include "${XDG_CONFIG_HOME}/shell/profile.d"

command unset -f shell_include
