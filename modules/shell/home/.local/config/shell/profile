#!/bin/sh

append() {
	path=":${PATH}:"

	if command test "${path#*":${1}:"}" = "${path}"
	then
		PATH="${PATH:+${PATH}:}${1}"
	fi

	command unset -v path
}

prepend() {
	path=":${PATH}:"

	if command test "${path#*":${1}:"}" = "${path}"
	then
		PATH="${1}${PATH:+:${PATH}}"
	fi

	command unset -v path
}

include() {
	directory="${1}"

	if command test -d "${directory}"
	then
		for file in "${directory}"/*.sh
		do
			if command test -r "${file}"
			then
				command . "${file}"
			fi
		done

		command unset -v file
	fi

	command unset -v directory
}

include "${XDG_CONFIG_HOME:-${HOME}/.local/config}/shell/profile.d"

command unset -f append
command unset -f prepend
command unset -f include
