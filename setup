#!/bin/bash

(
	command set -uo pipefail

	if command test "${EUID}" -eq 0
	then
		command echo "setup: do not run as root" >&2
		command exit 1
	fi

	command export XDG_CACHE_HOME="${HOME}/.local/cache"
	command export XDG_CONFIG_HOME="${HOME}/.local/config"
	command export XDG_DATA_HOME="${HOME}/.local/data"
	command export XDG_STATE_HOME="${HOME}/.local/state"

	command mkdir -p "${XDG_CACHE_HOME}"
	command mkdir -p "${XDG_CONFIG_HOME}"
	command mkdir -p "${XDG_DATA_HOME}"
	command mkdir -p "${XDG_STATE_HOME}"

	command readonly base="$(command dirname "$(command readlink -f "${BASH_SOURCE[0]}")")"
	command readonly distribution="$(source /etc/os-release && echo ${ID:-})"
	command readonly host="${base}/hosts/${SETUP_HOST:-$(command uname -n)}"

	if command test -r "${base}/distributions/${distribution}.sh"
	then
		command source "${base}/distributions/${distribution}.sh"
	else
		command echo "setup: unsupported distribution \"${distribution}\"" >&2
		command exit 1
	fi

	keepalive=""
	state=""

	privileges()
	{
		command sudo -v || command exit 1

		(
			while command kill -0 "${$}" 2> "/dev/null"
			do
				command sudo -n -v 2> "/dev/null"
				command sleep 60
			done
		) 2> "/dev/null" &

		keepalive="${!}"

		command disown "${keepalive}"
	}

	cleanup()
	{
		if command test -n "${keepalive:-}"
		then
			command pkill -P "${keepalive}" 2> "/dev/null"
			command kill "${keepalive}" 2> "/dev/null"
		fi

		command rm -rf "${state:-}"
	}

	distribution()
	{
		command test "${1:-}" == "${distribution}"
	}

	message()
	{
		command echo "${module}: ${1}" >> "${messages}" 2>&1
	}

	backup()
	{
		command local source
		command local backup

		source="${1}"
		backup="${XDG_STATE_HOME}/setup/backup/$(command basename "${source}")"

		if command test -f "${source}" -a ! -f "${backup}" && ! command cmp -s "${source}" "${backup}"
		then
			command mkdir -p "$(command dirname "${backup}")"
			command sudo mv "${source}" "${backup}"
			message "backup: ${backup}"
		fi
	}

	flathub()
	{
		command flatpak install --noninteractive flathub "${1}"
	}

	entries()
	{
		command local line

		if command test ! -r "${1}"
		then
			return 0
		fi

		while command read -r line || command test -n "${line}"
		do
			line="${line%%#*}"
			line="${line//[[:space:]]/}"

			if command test -n "${line}"
			then
				command echo "${line}"
			fi
		done < "${1}"
	}

	overridden()
	{
		command test "${path}" != "${host}" -a -e "${host}/${1}"
	}

	link()
	{
		command local backup
		command local relative
		command local source
		command local target

		while command read -r -d "" source
		do
			relative="${source#"${path}/home/"}"
			target="${HOME}/${relative}"

			if overridden "home/${relative}"
			then
				continue
			fi

			if command test -L "${target}" -a "$(command readlink "${target}")" == "${source}"
			then
				continue
			fi

			command mkdir -p "$(command dirname "${target}")"

			if command test -f "${target}" -a ! -L "${target}" && ! command cmp -s "${source}" "${target}"
			then
				backup="${base}/backup/${relative}.$(command date +%Y%m%d%H%M%S)"
				command mkdir -p "$(command dirname "${backup}")"
				command mv "${target}" "${backup}"
				message "backup: ${backup}"
			fi

			command ln -sfn "${source}" "${target}"
		done < <(command find "${path}/home" \( -type f -o -type l \) -print0)
	}

	copy()
	{
		command local backup
		command local relative
		command local source
		command local target

		while command read -r -d "" source
		do
			relative="${source#"${path}/root/"}"
			target="/${relative}"

			if overridden "root/${relative}"
			then
				continue
			fi

			if command cmp -s "${source}" "${target}" 2> "/dev/null"
			then
				continue
			fi

			command mkdir -p "$(command dirname "${target}")"

			if command test -f "${target}" -a ! -L "${target}" && ! command cmp -s "${source}" "${target}"
			then
				backup="${base}/backup/${relative}.$(command date +%Y%m%d%H%M%S)"
				command mkdir -p "$(command dirname "${backup}")"
				command sudo mv "${target}" "${backup}"
				message "backup: ${backup}"
			fi

			command sudo cp --no-preserve=ownership "${source}" "${target}"
		done < <(command find "${path}/root" -type f -print0)
	}

	prune()
	{
		command local stale

		while command read -r -d "" stale
		do
			command rm "${stale}"
		done < <(command find "${HOME}/.local" -xdev -type l -lname "${base}/*" -xtype l -print0 2> "/dev/null")
	}

	configure()
	{
		if command test -r "configure.sh"
		then
			command source "configure.sh"
		fi

		if command declare -F "pre" > "/dev/null"
		then
			pre
		fi

		if command test -d "home"
		then
			link
		fi

		if command test -d "root"
		then
			copy
		fi

		if command declare -F "post" > "/dev/null"
		then
			post
		fi
	}

	install()
	{
		if command test -r "install.sh"
		then
			command source "install.sh"
		fi
	}

	setup()
	{
		command local action
		command local module
		command local path
		command local log

		action="${1}"
		module="${2}"
		path="${3}"
		log="${path}/${action}.log"

		(
			command set -e
			command cd "${path}"

			"${action}"  > "${log}" 2>&1
		)

		command local status="${?}"

		if command test "${status}" -gt 0
		then
			message "${action} failed (${log})"
		else
			command rm "${log}"
		fi

		return "${status}"
	}

	host()
	{
		if command test ! -d "${host}"
		then
			return 0
		fi

		setup install "host" "${host}" && setup configure "host" "${host}"
	}

	module()
	{
		command local module
		command local path
		command local dependecy

		module="${1}"
		path="${base}/modules/${module}"

		if command test -e "${state}/${module}.done"
		then
			return 0
		fi

		if command test -e "${state}/${module}.failed"
		then
			return 1
		fi

		if command test ! -d "${path}"
		then
			message "module not found"
			return 1
		fi

		if command test -e "${state}/${module}.active"
		then
			message "circular dependency"
			return 1
		fi

		command touch "${state}/${module}.active"

		for dependency in $(entries "${path}/requires")
		do
			if ! module "${dependency}"
			then
				message "requires ${dependency}"
				command rm "${state}/${module}.active"
				command touch "${state}/${module}.failed"
				return 1
			fi
		done

		command local status

		status=0

		setup install "${module}" "${path}" && setup configure "${module}" "${path}" || status="${?}"

		command rm "${state}/${module}.active"

		if command test "${status}" -eq 0
		then
			command touch "${state}/${module}.done"
		else
			command touch "${state}/${module}.failed"
		fi

		return "${status}"
	}

	modules()
	{
		command local module
		command local -a include
		command local -a exclude

		include=()
		exclude=()

		for module in $(entries "${host}/modules")
		do
			if command test "${module:0:1}" == "!"
			then
				exclude+=("${module:1}")
			else
				include+=("${module}")
			fi
		done

		for module in "${base}/modules/"*
		do
			module="$(command basename "${module}")"

			if [[ " ${exclude[*]} " == *" ${module} "* ]]
			then
				continue
			fi

			if command test -f "${base}/modules/${module}/optional" && [[ " ${include[*]} " != *" ${module} "* ]]
			then
				continue
			fi

			command echo "${module}"
		done

		for module in "${include[@]}"
		do
			if command test ! -d "${base}/modules/${module}"
			then
				command echo "${module}"
			fi
		done
	}

	main()
	{
		command local status
		command local messages

		status=0
		state="$(command mktemp -d)"
		messages="${state}/messages.log"

		command trap cleanup EXIT

		privileges

		command local -a modules
		command local module

		modules=("${@}")

		if command test "${#modules[@]}" -eq 0
		then
			command mapfile -t modules < <(modules)
			modules+=("host")
		fi

		for module in "${modules[@]}"
		do
			if command test "${module}" == "host"
			then
				host || status=1
			else
				module "${module}" || status=1
			fi
		done

		prune

		if command test -f "${messages}"
		then
			command cat "${messages}"
		fi

		return "${status}"
	}

	main "${@}"
)
